# Configurações do Banco de Dados PostgreSQL
DB_DSN="host=localhost user=sgm_user password=sgm_password dbname=sgm_db port=5432 sslmode=disable TimeZone=America/Sao_Paulo"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sgm_db
DB_USER=sgm_user
DB_PASSWORD=sgm_password

# URL Base para arquivos e links
BASE_URL="http://localhost:8080"

# Segurança e JWT
JWT_SECRET="seu_jwt_secret_super_seguro_aqui"

# Integração Google Maps Distance Matrix API
GOOGLE_MAPS_API_KEY="SUA_CHAVE_GOOGLE_MAPS_AQUI"

# Configurações de E-mail (SMTP)
SMTP_USER="seu_email@dominio.com"
SMTP_PASS="sua_senha_de_aplicativo_aqui"
